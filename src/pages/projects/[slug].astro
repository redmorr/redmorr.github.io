---
import Layout from '../../layouts/Layout.astro';
import { projects, tagLabel } from '../../data/projects';

export function getStaticPaths() {
  return projects.map(p => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const label = project.type === 'unity' || project.type === 'python' ? 'Play' : 'Open App';
const embedUrl = project.embed === true ? project.url : project.embed;
const isGame = !!project.game;
// HTML apps grow to fit their content so nothing scrolls inside the iframe; canvas apps keep a fixed box.
const autoHeight = !!embedUrl && (project.type === 'aws' || project.type === 'web');
// A hardcoded-size page (Unity's template) gets exactly the box it asks for and the column widens to hold it.
// Never scale it: a CSS transform makes getBoundingClientRect() disagree with the canvas buffer size, so
// Unity's cursor mapping inflates every coordinate and the view drifts right and down.
const fixedSize = embedUrl ? project.embedSize : undefined;
const BORDER = 2; // the wrapper's 1px border per side, which sits outside the size the page needs
// a project with no embed links out to its store page, so name the store rather than saying "Play"
const host = project.url.startsWith('http') ? new URL(project.url).hostname : '';
const externalLabel = host.includes('steampowered') ? 'View on Steam'
  : host.includes('itch.io') ? 'View on itch.io'
  : label;
const wrapperStyle = fixedSize
  ? `width: ${fixedSize.w}px; height: ${fixedSize.h}px`
  : !autoHeight && project.embedAspect
    ? `aspect-ratio: ${project.embedAspect}`
    : undefined;
---

<Layout title={`${project.title} — redmorr`}>
  <a href="/" class="back">← Back</a>

  <article class="project" style={fixedSize ? `max-width: ${fixedSize.w + BORDER}px` : undefined}>
    <header class="project-header">
      <div class="tags">
        {(project.tags ?? [tagLabel[project.type]]).map((t, i) => (
          <span class:list={['tag', { primary: i === 0 }]}>{t}</span>
        ))}
      </div>
      <h1>{project.title}</h1>
      <p class="description">{project.longDescription}</p>
      <div class="links">
        {project.jamUrl && (
          <a href={project.jamUrl} target="_blank" rel="noopener noreferrer" class="jam-link">
            View jam page →
          </a>
        )}
        {project.submissionUrl && (
          <a href={project.submissionUrl} target="_blank" rel="noopener noreferrer" class="jam-link">
            View submission →
          </a>
        )}
      </div>
      {project.note && (
        <p class="note">📝 {project.note}</p>
      )}
    </header>

    {embedUrl ? (
      isGame ? (
        <div class:list={['embed-wrapper', { fixed: !!fixedSize }]} style={wrapperStyle}>
          <div class="embed-poster" id="poster">
            {project.thumbnail
              ? <img src={project.thumbnail} alt={project.title} class="poster-img" />
              : <div class="poster-bg" />
            }
            <button class="play-btn" id="play-btn" data-src={embedUrl}>
              <span class="play-icon">▶</span>
              {label}
            </button>
          </div>
          <iframe
            id="embed-frame"
            class="embed-frame hidden"
            allowfullscreen
          ></iframe>
        </div>
      ) : (
        <div
          class:list={['embed-wrapper', { 'auto-height': autoHeight, fixed: !!fixedSize }]}
          style={wrapperStyle}
        >
          <iframe
            src={embedUrl}
            class:list={['embed-frame', { 'auto-frame': autoHeight }]}
            allowfullscreen
          ></iframe>
        </div>
      )
    ) : null}

    {project.gallery && (
      <div class="gallery">
        {project.gallery.map(src => (
          <img src={src} alt={`${project.title} screenshot`} loading="lazy" />
        ))}
      </div>
    )}

    {project.storeEmbed && (
      <iframe
        src={project.storeEmbed.src}
        class="store-widget"
        style={`max-width: ${project.storeEmbed.width}px; height: ${project.storeEmbed.height}px`}
        title={`${project.title} on the store`}
      ></iframe>
    )}

    {!embedUrl && project.url && (
      <a href={project.url} target="_blank" rel="noopener noreferrer" class="external-btn">
        {externalLabel} →
      </a>
    )}
  </article>
</Layout>

<script>
  // Games: click the poster to load the heavy WebGL build.
  document.getElementById('play-btn')?.addEventListener('click', (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const frame = document.getElementById('embed-frame') as HTMLIFrameElement;
    frame.src = btn.dataset.src!;
    document.getElementById('poster')!.classList.add('hidden');
    frame.classList.remove('hidden');
  });

  // HTML apps: grow the iframe to its content so nothing scrolls inside it (same-origin only).
  const auto = document.querySelector('iframe.auto-frame') as HTMLIFrameElement | null;
  if (auto) {
    const fit = () => {
      try {
        const doc = auto.contentDocument;
        if (doc) auto.style.height = doc.documentElement.scrollHeight + 'px';
      } catch { /* cross-origin (e.g. local preview of a live URL): leave the fallback height */ }
    };
    auto.addEventListener('load', () => {
      fit();
      try {
        new ResizeObserver(fit).observe(auto.contentDocument!.documentElement);
      } catch { /* ignore */ }
    });
  }
</script>

<style>
  .back {
    display: inline-block;
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 2.5rem;
    transition: color 0.15s;
  }

  .back:hover {
    color: var(--text);
  }

  .project {
    max-width: 900px;
  }


  .project-header {
    margin-bottom: 2rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .tag {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--text-muted);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
  }

  .tag.primary {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
    background: color-mix(in srgb, var(--accent) 12%, var(--bg));
  }

  h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .description {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .links {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 0.75rem;
  }

  .jam-link {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.9rem;
    color: var(--accent);
    transition: color 0.15s;
  }

  .jam-link:hover {
    color: var(--accent-hover);
  }

  .note {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    padding: 0.6rem 0.85rem;
    border-radius: 4px;
  }

  .embed-wrapper {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--border);
    position: relative;
  }

  .embed-wrapper.auto-height {
    aspect-ratio: auto;
  }

  /* exact size from the data, unscaled; on a narrower screen it shrinks and scrolls like any fixed-width page.
     content-box so the 1px border sits outside the box the page needs rather than eating into it. */
  .embed-wrapper.fixed {
    aspect-ratio: auto;
    box-sizing: content-box;
    max-width: calc(100% - 2px);
  }

  .embed-poster {
    width: 100%;
    height: 100%;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .poster-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .poster-bg {
    position: absolute;
    inset: 0;
    background: #111;
  }

  .play-btn {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--accent);
    color: #fff;
    border: none;
    font-size: 1.1rem;
    font-weight: 600;
    padding: 0.85rem 2.25rem;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
  }

  .play-btn:hover {
    background: var(--accent-hover);
    transform: scale(1.04);
  }

  .play-icon {
    font-size: 0.9rem;
  }

  .embed-frame {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  /* auto-height apps: JS sets the exact content height; this is the pre-JS fallback */
  .embed-frame.auto-frame {
    height: 85vh;
  }

  .hidden {
    display: none;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.75rem;
  }

  .gallery img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid var(--border);
    border-radius: 6px;
    display: block;
  }

  .store-widget {
    display: block;
    width: 100%;
    border: none;
    margin-top: 1.5rem;
  }

  .external-btn {
    display: inline-block;
    background: var(--accent);
    color: #fff;
    font-weight: 600;
    font-size: 1rem;
    padding: 0.75rem 2rem;
    border-radius: 6px;
    margin-top: 1rem;
    transition: background 0.2s, transform 0.2s;
  }

  .external-btn:hover {
    background: var(--accent-hover);
    transform: translateY(-1px);
  }
</style>
