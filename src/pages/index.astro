---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';

const groups: { title: string; slugs: string[] }[] = [
  { title: 'Software Engineering', slugs: ['prescription-app', 'maze-viz', 'rbmk-sim'] },
  { title: 'Video Games & Prototypes', slugs: ['chinese-empire', 'pawnshop-90s', 'minijam-119', 'colt63', 'missile-command', 'navmesh-agent-simulation', 'spring-sway', 'pickup-physics'] },
];

const bySlug = new Map(projects.map(p => [p.slug, p]));
const sections = groups.map(g => ({ title: g.title, items: g.slugs.map(s => bySlug.get(s)!) }));

// safety: surface any project not placed in a group instead of silently dropping it
const placed = new Set(groups.flatMap(g => g.slugs));
const orphans = projects.filter(p => !placed.has(p.slug));
if (orphans.length) sections.push({ title: 'More', items: orphans });
---

<Layout title="Przemysław Szurek — Software Engineer & Game Developer">
  <section class="hero">
    <h1>Przemysław Szurek</h1>
    <p class="tagline">Software Engineer <span>&amp;</span> Game Developer</p>
  </section>

  {sections.map(section => (
    <section class="section">
      <h2 class="section-title">{section.title}</h2>
      <div class="grid">
        {section.items.map(project => <ProjectCard project={project} />)}
      </div>
    </section>
  ))}
</Layout>

<style>
  .hero {
    margin-bottom: 3rem;
  }

  .hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 0.4rem;
  }

  .tagline {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.01em;
  }

  .tagline span {
    color: var(--accent);
    font-weight: 600;
    margin: 0 0.15em;
  }

  .section {
    margin-bottom: 3.5rem;
  }

  .section-title {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    padding-bottom: 0.75rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
</style>
